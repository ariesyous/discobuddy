# Copy this file to .env.discord and set your token from the Discord Developer Portal.
# .env.discord is ignored by Git; never commit or share your bot token.
# A token is only needed to connect the bot to Discord, not for local previews.
DISCORD_BOT_TOKEN=

# Optional: both services listen on 127.0.0.1. Uncomment to change either port.
# DISCOBUDDY_DISCORD_PORT=8767
# DISCOBUDDY_MODEL_PORT=8765
